    "/openligadb/leagues": {
      "get": {
        "consumes": [
          "application/json"
        ],
        "description": "Returns every league-season record across all sports. Set `season` to the season's starting year to use OpenLigaDB's season-specific listing. This is the discovery source for `league_shortcut`, `league_id`, and `sport`; shortcuts may repeat across seasons, and the response is not paginated. The catalog is community-maintained and may include user-created or legacy entries; verify a selected pair through groups or matches.",
        "operationId": "openligadb-leagues",
        "parameters": [
          {
            "description": "Optional season starting year, e.g. 2026 for 2026/27",
            "in": "query",
            "name": "season",
            "type": "integer"
          }
        ],
        "produces": [
