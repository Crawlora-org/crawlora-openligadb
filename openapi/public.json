    "/openligadb/matchday-matches": {
      "get": {
        "consumes": [
          "application/json"
        ],
        "description": "Returns all fixtures and results for one discovered league shortcut, season and group order id. Use `openligadb_groups` to discover valid matchday or round ids.",
        "operationId": "openligadb-matchday-matches",
        "parameters": [
