      "backgroundColor": "#FFFFFF",
      "url": "https://raw.githubusercontent.com/Crawlora-org/crawlora-mcp/main/assets/logo-400x400.png"
    }
  },
  "paths": {
    "/openligadb/current-group": {
      "get": {
        "consumes": [
          "application/json"
        ],
        "description": "Returns OpenLigaDB's current group or matchday for a league shortcut. Use `openligadb_groups` for all matchdays and `openligadb_current_matchday` for the matches in this group.",
        "operationId": "openligadb-current-group",
        "parameters": [
          {
            "description": "Exact shortcut from openligadb-leagues",
            "in": "query",
            "name": "league_shortcut",
            "required": true,
            "type": "string",
            "x-example": "bl1"
          }
        ],
        "produces": [
          "application/json"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/openligadb.objectResponseDoc"
            }
          },
          "400": {
            "description": "Bad Request",
            "schema": {
              "$ref": "#/definitions/app.Response"
            }
          },
          "404": {
            "description": "Not Found",
            "schema": {
              "$ref": "#/definitions/app.Response"
            }
          },
          "429": {
            "description": "Too Many Requests",
            "schema": {
              "$ref": "#/definitions/app.Response"
            }
          },
          "503": {
            "description": "Service Unavailable",
            "schema": {
              "$ref": "#/definitions/app.Response"
            }
          }
        },
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "summary": "Get the current league matchday",
        "tags": [
          "openligadb"
        ]
      }
    },
